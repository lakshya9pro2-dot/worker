{
  "manifest_version": 3,
  "name": "Kineflex Resolver",
  "version": "1.0.0",
  "description": "Authorized browser-side resolution for Kineflex fallback.",
  "permissions": [
    "scripting",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://kineflex.site/*",
    "*://testingplaty.netlify.app/*",
    "*://worker.kineflex-netflex.workers.dev/*",
    "*://vidfast.vc/*",
    "*://*.peakstorm.top/*",
    "*://*.keenanchor.top/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "resolver@kineflex.site",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://kineflex.site/*",
        "*://testingplaty.netlify.app/*",
        "*://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
